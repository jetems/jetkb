<div class="panel margin-block-double center shadow">
  <h1 class="font-black txt-x-large margin-none-block-end"><%= t(".title") %></h1>
  <p class="margin-block-start-half"><%= t(".body_html", name: @user.first_name, settings_link: link_to(t(".settings_link"), notifications_settings_path)) %></p>

  <%= link_to root_path, class: "btn btn--link margin-block-start" do %>
    <%= icon_tag "arrow-left" %>
    <span><%= t(".back") %></span>
  <% end %>
</div>
