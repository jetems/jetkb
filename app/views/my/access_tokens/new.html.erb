<% @page_title = t(".page_title") %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to t(".back_to_tokens"), my_access_tokens_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>

  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
<% end %>

<article class="panel panel--wide shadow center txt-align-start" style="view-transition-name: <%= dom_id(@access_token) %>">
  <%= form_with model: @access_token, url: my_access_tokens_path, scope: :access_token, data: { controller: "form" }, html: { class: "flex flex-column gap" } do |form| %>
    <div class="flex flex-column gap-half">
      <strong><%= form.label :description, t(".description_label") %></strong>
      <%= form.text_field :description, required: true, autofocus: true, class: "input", placeholder: t(".description_placeholder"), data: { action: "keydown.esc@document->form#cancel" } %>
    </div>

    <div class="flex flex-column gap-half">
      <strong><%= form.label :permission, t(".permission_label") %></strong>
      <%= form.select :permission, options_for_select({ t(".permission_read") => "read", t(".permission_write") => "write"}), {}, class: "input input--select" %>
    </div>

    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
      <span><%= t(".submit") %></span>
    <% end %>

     <%= link_to t(".cancel"), my_access_tokens_path, data: { form_target: "cancel" }, hidden: true %>
  <% end %>
</article>
