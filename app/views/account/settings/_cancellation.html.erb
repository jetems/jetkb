<% if Current.account.cancellable? && Current.user.owner? %>
  <section class="settings__section settings__section--negative">
    <header>
      <h2 class="divider"><%= t(".title") %></h2>
      <div><%= t(".description_html").html_safe %></div>
    </header>

    <div data-controller="dialog toggle-enable" data-dialog-modal-value="true">
      <button type="button" class="btn btn--negative" data-action="dialog#open"><%= t(".open") %></button>

      <dialog class="dialog panel panel--wide shadow" data-dialog-target="dialog" data-action="close->toggle-enable#reset" style="--panel-size: 48ch;">
        <h2 class="margin-none txt-large txt-negative"><%= t(".dialog_title") %></h2>
        <div class="txt-align-start">
          <h3 class="margin-block-start margin-block-end-half txt-normal"><%= t(".what_happens") %></h3>
          <ul class="list-unindented margin-block-start-half margin-block-end">
            <li><%= t(".bullet_close_html", name: Current.account.name).html_safe %></li>
            <li><%= t(".bullet_users") %></li>
            <% if Current.account.try(:active_subscription) %>
              <li><%= t(".bullet_subscription") %></li>
            <% end %>
            <li><%= t(".bullet_delete_html").html_safe %></li>
          </ul>

          <h3 class="margin-block-end-half txt-normal"><%= t(".export_reminder") %></h3>
          <p class="margin-block-start-half margin-block-end">
            <%= t(".export_link_html", link: tag.button(t(".export_link_label"), type: "button", class: "btn btn--plain txt-link", data: { controller: "dispatch-event", dispatch_event_name_value: "open-export", action: "click->dialog#close click->dispatch-event#fire" })).html_safe %>
          </p>
        </div>

        <label class="flex gap justify-start txt-align-start margin-block-end-double">
          <input type="checkbox" class="checkbox" data-toggle-enable-target="checkbox" data-action="change->toggle-enable#toggle">
          <%= t(".confirm_checkbox") %>
        </label>

        <div class="flex gap justify-center">
          <button type="button" class="btn" autofocus data-action="dialog#close"><%= t(".not_now") %></button>
          <%= button_to t(".delete_my_account"), account_cancellation_path,
              method: :post,
              class: "btn btn--negative",
              disabled: true,
              form: { data: { action: "submit->dialog#close", turbo: false } },
              data: { toggle_enable_target: "element" } %>
        </div>
      </dialog>
    </div>
  </section>
<% end %>
