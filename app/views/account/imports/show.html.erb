<% @page_title = t(".page_title") %>

<%= turbo_stream_from @import %>

<div class="panel panel--centered flex flex-column gap-half" style="--panel-size: 54ch;">
  <h1 class="txt-x-large font-weight-black margin-block-end"><%= t(".heading") %></h1>

  <% case @import.status %>
  <% when "pending", "processing" %>
    <div class="import-status">
      <%= t(".in_progress") %>
    </div>
  <% when "completed" %>
    <div class="import-status import-status--success">
      <div><strong><%= t(".success") %></strong></div>
      <%= link_to t(".go_to_account"), landing_url(script_name: @import.account.slug), class: "btn btn--link" %>
    </div>
  <% when "failed" %>
    <div class="import-status import-status--error">
      <div><strong><%= t(".failed") %></strong></div>
      <% if @import.failed_due_to_conflict? %>
        <% kind = Fizzy.saas? ? t(".failed_conflict_kind_self") : JetKB::Brand::DOMAIN %>
        <div><%= t(".failed_conflict_html", kind: kind) %></div>
      <% elsif @import.failed_due_to_invalid_export? %>
        <div><%= t(".failed_invalid") %></div>
      <% else %>
        <div><%= t(".failed_other") %></div>
      <% end %>
      <%= link_to t(".try_again"), new_account_import_path, class: "btn" %>
    </div>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
