<% @page_title = t(".page_title") %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to t(".back"), edit_user_path(@user, script_name: @user.account.slug), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <h1 class="txt-x-large font-weight-black margin-none"><%= t(".title") %></h1>
  <p class="margin-none"><%= t(".sent_html", email: tag.strong(params[:email_address])) %></p>
  <p class="margin-none-block-start margin-block-end-half"><%= t(".instruction") %></p>

  <%= link_to t(".done"), edit_user_path(@user, script_name: @user.account.slug), class: "btn btn--link center" %>
</div>
