<% @page_title = t(".page_title") %>

<div class="panel panel--centered center flex flex-column gap-half" style="--panel-size: 50ch;">
  <h1 class="txt-x-large font-weight-black margin-none">
    <%= @page_title %>
  </h1>
  <p class="margin-none-block-start margin-block-end-half">
    <%= t(".body") %>
  </p>

  <%= link_to t(".retry"), new_user_email_address_path(user_id: @user, script_name: @user.account.slug), class: "btn btn--link center" %>

  <p class="txt-small txt-subtle">
    <%= t(".stuck_html", email_link: mail_to(JetKB::Brand::SUPPORT_EMAIL, t("common.send_us_an_email_lower"))) %>
  </p>
</div>
