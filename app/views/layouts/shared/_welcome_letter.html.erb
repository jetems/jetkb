<div data-controller="dialog" data-dialog-auto-open-value="true" data-dialog-modal-value="true">
  <dialog class="welcome-letter panel panel--wide shadow dialog" data-dialog-target="dialog">
    <button class="welcome-letter__close btn txt-x-small" data-action="dialog#close">
      <%= icon_tag "close" %>
      <span class="for-screen-reader"><%= t("layouts.welcome_letter.close") %></span>
    </button>

    <h2 class="txt-medium margin-none txt-tight-lines"><%= t("layouts.welcome_letter.heading") %></h2>

    <p></p>

    <p><%= t("layouts.welcome_letter.body_html") %></p>

    <ol class="welcome-letter__steps">
      <% 4.times do |i| %>
        <li><%= t("layouts.welcome_letter.steps.#{i + 1}_html") %></li>
      <% end %>
    </ol>

    <p><%= t("layouts.welcome_letter.tip_html") %></p>
  </dialog>
</div>
