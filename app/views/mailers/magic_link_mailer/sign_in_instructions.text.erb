<% if @magic_link.for_sign_in? -%>
<%= t(".subtitle_sign_in") %>
<% else -%>
<%= t(".subtitle_welcome") %>
<% end -%>

<%= @magic_link.code %>

<%= t(".code_validity", duration: distance_of_time_in_words(MagicLink::EXPIRATION_TIME)) %>

<% if account = @magic_link.identity.accounts.last -%>
<%= t(".passkey_tip_text", passkey_url: my_passkeys_url(script_name: account.slug)) %>
<% end -%>
