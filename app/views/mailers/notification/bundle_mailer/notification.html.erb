<tr>
  <td>
    <h1 class="title"><%= t(".title", since: @bundle.starts_at.strftime(t(".since_format"))) %></h1>
    <p class="subtitle margin-block-end-double">
      <% count_link = link_to(t(".notification_count", count: @notifications.count), notifications_url) %>
      <% if @user.identity.accounts.many? %>
        <%= t(".intro_multi_html", link: count_link, account: Current.account.name) %>
      <% else %>
        <%= t(".intro_single_html", link: count_link) %>
      <% end %>
    </p>

    <% @notifications.group_by { |n| n.card.board }.sort_by { |board, _| board.name.downcase }.each do |board, board_notifications| %>
      <hr class="notification__board-separator">
      <h2 class="notification__board"><%= link_to board.name, board %></h2>
      <% board_notifications.group_by(&:card).each do |card, notifications| %>
        <%= link_to card, class: "card__title" do %>#<%= card.number %> <%= card_html_title(card) %><% end %>
        <%= render partial: "notification/bundle_mailer/notification", collection: notifications, as: :notification %>
      <% end %>
    <% end %>

    <p class="footer"><%= t(".footer") %> <br>
      <%= link_to t(".change_frequency"), notifications_settings_url %>
      <%= t(".or") %> <%= link_to t(".unsubscribe"), new_notifications_unsubscribe_url(access_token: @unsubscribe_token) %>.
    </p>
  </td>
</tr>
