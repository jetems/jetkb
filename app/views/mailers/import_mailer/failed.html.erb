<p class="subtitle"><%= t("import_mailer.failed.subtitle") %></p>

<% if @import.failed_due_to_conflict? %>
  <p><%= t("import_mailer.failed.conflict") %></p>
<% elsif @import.failed_due_to_invalid_export? %>
  <p><%= t("import_mailer.failed.invalid") %></p>
<% else %>
  <p><%= t("import_mailer.failed.other") %></p>
<% end %>

<p class="footer"><%= t("import_mailer.failed.footer_html", link: mail_to(JetKB::Brand::SUPPORT_EMAIL, t("import_mailer.failed.send_email"))).html_safe %></p>
